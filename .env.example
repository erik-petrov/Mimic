# Settings for compose.yaml. Copy this file to .env and edit it:
#   cp .env.example .env

# Port on this server that serves the web app and Rift together.
# Point your reverse proxy at it, with websockets allowed.
MIMIC_PORT=8080

# Your domain. Only used by the optional Caddy service:
#   docker compose --profile caddy up -d --build
# Leave it empty if you use your own reverse proxy.
MIMIC_DOMAIN=mimic.example.com

# Where the web app finds Rift. "/" uses the Rift in this compose file, on the same address.
# Set wss://rift.mimic.lol to use the shared Rift instead. Changing this needs a rebuild (--build).
MIMIC_RIFT_URL=/
